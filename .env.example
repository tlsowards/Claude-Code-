# Copy to .env and fill in. All values are public configuration, not secrets.

# Public URL the app is served from (no trailing slash).
VITE_PUBLIC_URL=https://app.sowardsconsulting.com

# Serve the app from a sub-folder, for example /app/ on sowardsconsulting.com. Leave as / for the site root.
BASE_PATH=/

# Base URL where podcast MP3 files are hosted, for example a Bunny Stream pull zone. No trailing slash.
VITE_AUDIO_BASE_URL=

# MailerLite embedded form action URL for the Subscribe page.
VITE_MAILERLITE_FORM_ACTION=
